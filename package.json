{
  "name": "view3",
  "version": "1.0.0",
  "description": "A Vue 3 component library built with Vite.",
  "license": "MIT",
  "author": "WENWU YAN <webank@139.com>",
  "homepage": "https://github.com/gatework/view3#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gatework/view3.git"
  },
  "bugs": {
    "url": "https://github.com/gatework/view3/issues"
  },
  "packageManager": "yarn@1.22.22",
  "main": "dist/view3.mjs",
  "module": "dist/view3.mjs",
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "yarn dev",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "build:lib": "vite build --config vite.lib.config.mjs",
    "build": "yarn build:prod && yarn build:lib",
    "lint": "yarn lint:js && yarn lint:style",
    "lint:js": "eslint \"src/**/*.{js,vue}\" \"examples/**/*.{js,vue}\"",
    "lint:js:fix": "yarn lint:js --fix",
    "lint:style": "stylelint \"src/**/*.{scss,css}\" --allow-empty-input",
    "lint:style:fix": "yarn lint:style --fix",
    "format": "yarn lint:js:fix && yarn lint:style:fix",
    "ci": "yarn lint && yarn build"
  },
  "peerDependencies": {
    "vue": "^3.5.35"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "async-validator": "^4.2.5",
    "clipboard": "^2.0.11",
    "element-resize-detector": "^1.2.4",
    "ionicons": "^3.0.0",
    "js-calendar": "^1.2.3",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.35",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "pinia": "^3.0.4",
    "postcss": "^8.5.15",
    "postcss-preset-env": "^11.3.0",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-scss": "^7.1.1",
    "vite": "^8.0.14",
    "vue": "^3.5.35",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^5.1.0"
  }
}
